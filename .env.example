# Supabase project credentials (Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Domain used to map patient registration numbers to auth emails.
# Must match the value used by the Edge Functions. Keep as-is unless you know why.
EXPO_PUBLIC_PATIENT_EMAIL_DOMAIN=tedavitakip.local
