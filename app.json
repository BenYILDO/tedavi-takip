{
  "expo": {
    "name": "Antikoagülasyon Takip",
    "slug": "tedavi-takip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tedavitakip",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tedavitakip.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tedavitakip.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0E7C7B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C7B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0E7C7B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafınızı seçebilmek için galeri erişimi gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b45d1951-8d76-4742-8253-e9411391f978"
      }
    },
    "owner": "benyildo"
  }
}
